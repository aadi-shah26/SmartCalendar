NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# --- Google Calendar sync ---------------------------------------------------
# Optional: public base URL of the app (no trailing slash). Leave unset locally (falls back to
# http://localhost:3000); set it to your domain when hosted. "<this>/api/auth/callback" must be
# listed as an authorised redirect URI on the Google OAuth client.
NEXT_PUBLIC_SITE_URL=

# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SERVER-ONLY secrets. Never prefix with NEXT_PUBLIC_.
# Supabase > Project Settings > API > service_role key. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts stored Google refresh tokens and signs the OAuth state. Changing it forces users to reconnect.
GOOGLE_TOKEN_ENCRYPTION_KEY=
