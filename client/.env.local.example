NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: public base URL of the deployed app (no trailing slash). Falls back to the current origin.
# Must be whitelisted as "<NEXT_PUBLIC_SITE_URL>/api/auth/callback" in the Google Cloud OAuth client.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
